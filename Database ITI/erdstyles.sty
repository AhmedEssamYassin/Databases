%% erdstyles.sty -- shared ERD / EERD / relational-schema drawing styles
%% Used by Database_ITI.tex and erd_components.tex. Keep this file in the
%% same folder as the documents and load it with \usepackage{erdstyles}.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{erdstyles}[2026/09/29 Chen-notation ERD styles for the ITI Database guide]

\RequirePackage{xcolor}
\RequirePackage{tikz}
\usetikzlibrary{shapes.geometric, shapes.multipart, arrows.meta, positioning, fit, calc}

% Colours used by the schema diagram (only defined if the document has not defined them)
\providecolor{primaryblue}{RGB}{0, 51, 102}
\providecolor{secondaryteal}{RGB}{0, 102, 102}

%% ------------------------------------------------------------------
%% Chen-notation node and line styles
%% ------------------------------------------------------------------
\tikzset{
    entity/.style={rectangle, draw, black, very thick, minimum width=2.5cm, minimum height=1.0cm, fill=blue!8, align=center},
    weak entity/.style={rectangle, draw, black, very thick, double, double distance=2pt, minimum width=2.5cm, minimum height=1.0cm, fill=blue!8, align=center},
    attribute/.style={ellipse, draw, black, thick, minimum width=2.0cm, minimum height=0.8cm, fill=green!8, align=center},
    key attribute/.style={attribute},
    partial key attribute/.style={attribute},
    derived attribute/.style={attribute, dashed, fill=green!3},
    multivalued attribute/.style={attribute, double, double distance=2pt},
    relationship/.style={diamond, draw, black, very thick, minimum width=2.2cm, minimum height=1.2cm, fill=red!8, align=center, aspect=1.8, inner sep=1pt},
    identifying relationship/.style={relationship, double, double distance=2pt},
    spec circle/.style={circle, draw, black, thick, minimum size=0.8cm, fill=yellow!15, align=center, font=\bfseries},
    link/.style={draw, thick},
    total link/.style={draw, thick, double, double distance=1.5pt},
    partial link/.style={draw, thick},
    card/.style={font=\small, inner sep=2pt},
    role/.style={font=\footnotesize\itshape, inner sep=2pt},
}
% Subset symbol (U-shaped arc) on a subtype line, opening toward the
% specialization circle, as in Elmasri & Navathe. Usage: \subsetmark{circle}{subtype}
\newcommand*{\subsetmark}[2]{%
  \pgfmathanglebetweenpoints{\pgfpointanchor{#1}{center}}{\pgfpointanchor{#2}{center}}%
  \edef\subsetangle{\pgfmathresult}%
  \draw[thick, shift={($(#1)!0.5!(#2)$)}, rotate=\subsetangle]
    (-0.08,0.2) arc[start angle=90, end angle=-90, radius=0.2];%
}
% Dashed underline for partial keys (no extra package needed)
\newcommand{\partialkey}[1]{%
  \setbox0\hbox{#1}\leavevmode
  \rlap{\raisebox{-0.35ex}{\hbox to\wd0{\leaders\hbox{\rule{2.5pt}{0.5pt}\hskip1.5pt}\hfil}}}\box0}

%% ------------------------------------------------------------------
%% Ready-made diagrams
%% ------------------------------------------------------------------
% Company case-study ERD
\newcommand{\CompanyERD}{%
\begin{tikzpicture}
    % ---------- Entities ----------
    \node[entity]      (emp)  at (0,0)   {Employee};
    \node[entity]      (dept) at (12,0)  {Department};
    \node[entity]      (proj) at (12,-8) {Project};
    \node[weak entity] (dep)  at (0,-8)  {Dependent};

    % ---------- Relationships ----------
    \node[relationship]             (works)    at (6,0)    {Works\_For};
    \node[relationship]             (manages)  at (6,3.4)  {Manages};
    \node[relationship]             (controls) at (12,-4)  {Controls};
    \node[relationship]             (workson)  at (6,-4.4) {Works\_On};
    \node[identifying relationship] (has)      at (0,-4)   {Has};
    \node[relationship]             (super)    at (-5.4,0) {Supervises};

    % ---------- Employee attributes ----------
    \node[key attribute] (ssn)    at (-3.7,2.1)  {\underline{SSN}};
    \node[attribute]     (name)   at (-1.3,3.0)  {Name};
    \node[attribute]     (fname)  at (-3.0,4.5)  {Fname};
    \node[attribute]     (lname)  at (0.4,4.5)   {Lname};
    \node[attribute]     (salary) at (1.0,2.0)   {Salary};
    \node[attribute]     (bdate)  at (-3.9,-2.6) {Bdate};
    \node[attribute]     (sex)    at (-1.7,-3.0) {Gender};
    \path[link] (emp) edge (ssn) edge (name) edge (salary) edge (bdate) edge (sex);
    \path[link] (name) edge (fname) edge (lname);

    % ---------- Department attributes ----------
    \node[key attribute]         (dname) at (11.3,2.5) {\underline{Dname}};
    \node[key attribute]         (dnum)  at (13.8,2.4) {\underline{DNUM}};
    \node[multivalued attribute] (locs)  at (15.3,0.9) {Locations};
    \path[link] (dept) edge (dname) edge (dnum) edge (locs);

    % ---------- Project attributes ----------
    \node[key attribute] (pnum)  at (9.7,-10.2)  {\underline{PNumber}};
    \node[key attribute] (pname) at (12,-10.7)   {\underline{Pname}};
    \node[attribute]     (ploc)  at (14.3,-10.2) {Plocation};
    \path[link] (proj) edge (pnum) edge (pname) edge (ploc);

    % ---------- Dependent attributes (weak entity: partial key) ----------
    \node[partial key attribute] (depname)  at (-2.3,-10.2) {\partialkey{DepName}};
    \node[attribute]             (depsex)   at (0,-10.7)    {Gender};
    \node[attribute]             (depbdate) at (2.3,-10.2)  {Bdate};
    \path[link] (dep) edge (depname) edge (depsex) edge (depbdate);

    % ---------- Relationship attributes ----------
    \node[attribute] (hire)  at (6,5.1)  {Hire\_Date};
    \node[attribute] (hours) at (6,-6.2) {Hours};
    \path[link] (manages) -- (hire);
    \path[link] (workson) -- (hours);

    % ---------- Connections (single = partial, double = total) ----------
    % Works_For  (N:1, both total)
    \path[total link] (emp)   -- node[card, above] {$M$} (works);
    \path[total link] (works) -- node[card, above] {$1$} (dept);
    % Manages    (1:1, Employee partial, Department total)
    \path[link]       (emp.north east)  -- node[card, above left]  {$1$} (manages);
    \path[total link] (dept.north west) -- node[card, above right] {$1$} (manages);
    % Controls   (1:N, Department partial, Project total)
    \path[link]       (dept)     -- node[card, right] {$1$} (controls);
    \path[total link] (controls) -- node[card, right] {$M$} (proj);
    % Works_On   (M:N, both total)
    \path[total link] (emp)     -- node[card, above right] {$M$} (workson);
    \path[total link] (workson) -- node[card, above right] {$N$} (proj);
    % Has        (identifying 1:N, Employee partial, Dependent total)
    \path[link]       (emp) -- node[card, right] {$1$} (has);
    \path[total link] (has) -- node[card, right] {$M$} (dep);
    % Supervises (recursive 1:N, partial on both roles)
    \path[link] (emp.north west)  -- node[role, above, sloped] {supervisor \quad $1$} (super.north east);
    \path[link] (emp.south west) -- node[role, below, sloped] {supervisee \quad $M$} (super.south east);
\end{tikzpicture}
}

% Vehicle specialization EERD (total, disjoint)
\newcommand{\VehicleEERD}{%
\begin{tikzpicture}
    % Supertype and its attributes
    \node[entity] (v) at (0,0) {Vehicle};
    \node[key attribute] (vid)    at (-3.2,1.8) {\underline{Vehicle-ID}};
    \node[attribute]     (vname)  at (0,2.3)    {Vehicle-Name};
    \node[attribute]     (vprice) at (3.2,1.8)  {Price};
    \path[link] (v) edge (vid) edge (vname) edge (vprice);

    % Specialization circle: double line = total, d = disjoint
    \node[spec circle] (c) at (0,-2) {d};
    \path[total link] (v) -- (c);

    % Subtypes
    \node[entity] (car)   at (-4.5,-4.5) {Car};
    \node[entity] (truck) at (4.5,-4.5)  {Truck};
    \draw[thick] (c) -- (car);
    \draw[thick] (c) -- (truck);
    \subsetmark{c}{car}
    \subsetmark{c}{truck}

    % Local (specific) attributes
    \node[attribute] (make)  at (-6.2,-6.6) {Make};
    \node[attribute] (model) at (-2.8,-6.6) {Model};
    \path[link] (car) edge (make) edge (model);

    \node[attribute] (glass) at (1.9,-6.6)  {Glass-Type};
    \node[attribute] (cab)   at (4.5,-7.2)  {Cab-Type};
    \node[attribute] (cap)   at (6.8,-6.6)  {Capacity};
    \path[link] (truck) edge (glass) edge (cab) edge (cap);
\end{tikzpicture}
}

% Relational schema of the mapped Company ERD (arrows: foreign key -> primary key)
\newcommand{\CompanySchema}{%
\begin{tikzpicture}[
    tbl/.style={rectangle split, rectangle split horizontal, rectangle split ignore empty parts=false,
                draw, thick, fill=blue!4, font=\small, inner ysep=5pt, inner xsep=6pt,
                anchor=west, minimum height=0.6cm},
    tname/.style={font=\small\bfseries\sffamily, text=primaryblue},
    fkarrow/.style={-{Stealth[length=2.2mm]}, thick, rounded corners=3pt, draw=secondaryteal},
]
    % ---------- Tables (PK underlined) ----------
    \node[tbl, rectangle split parts=8] (E) at (0,0)
        {\underline{SSN}\nodepart{two}Fname\nodepart{three}Lname\nodepart{four}Bdate
         \nodepart{five}Gender\nodepart{six}Salary\nodepart{seven}DNum\nodepart{eight}Super\_SSN};

    \node[tbl, rectangle split parts=4] (D) at (0,-2.2)
        {\underline{DNUM}\nodepart{two}DName\nodepart{three}MgrSSN\nodepart{four}HireDate};

    \node[tbl, rectangle split parts=2] (L) at (0,-4.4)
        {\underline{DNum}\nodepart{two}\underline{Location}};

    \node[tbl, rectangle split parts=4] (P) at (0,-6.6)
        {\underline{PNumber}\nodepart{two}PName\nodepart{three}Location\nodepart{four}DNum};

    \node[tbl, rectangle split parts=3] (W) at (0,-8.8)
        {\underline{ESSN}\nodepart{two}\underline{PNum}\nodepart{three}Hours};

    \node[tbl, rectangle split parts=4] (T) at (0,-11)
        {\underline{ESSN}\nodepart{two}\underline{DependentName}\nodepart{three}Gender\nodepart{four}Bdate};


    % Table names
    \node[tname, right=3mm] at (E.east) {Employee};
    \node[tname, right=3mm] at (D.east) {Department};
    \node[tname, right=3mm] at (L.east) {Dept\_Location};
    \node[tname, right=3mm] at (P.east) {Project};
    \node[tname, right=3mm] at (W.east) {Works\_On};
    \node[tname, right=3mm] at (T.east) {Dependent};

    % ---------- Foreign keys: FK cell -> referenced PK ----------
    % Employee.Super_SSN -> Employee.SSN (recursive, routed over the top)
    \draw[fkarrow] (E.eight north) -- ++(0,0.45) -| ($(E.one north)+(0.25,0)$);
    % Employee.DNum -> Department.DNUM
    \draw[fkarrow] (E.seven south) -- ++(0,-0.35) -| (-0.5,-2.2) -- (D.west);
    % Department.MgrSSN -> Employee.SSN
    \draw[fkarrow] (D.three north) -- ++(0,0.35) -| (-1.7,0) -- (E.west);
    % Dept_Location.DNum -> Department.DNUM
    \draw[fkarrow] (L.one south) -- ++(0,-0.35) -| (-0.9,-2.2) -- (D.west);
    % Project.DNum -> Department.DNUM
    \draw[fkarrow] (P.four north) -- ++(0,0.35) -| (-1.3,-2.2) -- (D.west);
    % Works_On.PNum -> Project.PNumber
    \draw[fkarrow] (W.two north) -- ++(0,0.35) -| (P.one south);
    % Works_On.ESSN -> Employee.SSN
    \draw[fkarrow] (W.one south) -- ++(0,-0.35) -| (-2.1,0) -- (E.west);
    % Dependent.ESSN -> Employee.SSN
    \draw[fkarrow] (T.one south) -- ++(0,-0.35) -| (-2.5,0) -- (E.west);
\end{tikzpicture}
}

